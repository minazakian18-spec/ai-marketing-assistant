# APP
APP_URL=http://localhost:3000
# Production: https://mavix.webbo-solutions.nl
# DATABASE / AUTH: copy from Supabase project settings; all used server-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# GOOGLE login is configured in Supabase Auth, separately from these integrations.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# META (Facebook Login for Messenger; the app secret also signs Page and WhatsApp webhooks)
META_CLIENT_ID=
META_CLIENT_SECRET=
META_GRAPH_VERSION=v25.0
# Instagram API with Instagram Login (Instagram app id/secret from the same Meta app)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Random string you also enter in the Meta webhook settings (callback: APP_URL/api/webhooks/meta)
META_WEBHOOK_VERIFY_TOKEN=
# ENCRYPTION: 32 random bytes, base64, server-only; keep a secure backup.
OAUTH_ENCRYPTION_KEY=
# BILLING
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTH=
STRIPE_PRICE_STARTER_YEAR=
STRIPE_PRICE_GROWTH_MONTH=
STRIPE_PRICE_GROWTH_YEAR=
STRIPE_PRICE_AUTOPILOT_MONTH=
STRIPE_PRICE_AUTOPILOT_YEAR=
# EMAIL transactional delivery (not customer Gmail)
EMAIL_API_KEY=
EMAIL_FROM=
# SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# SEO: Google PageSpeed Insights API key (server-only). Without a key Google's shared quota is usually exhausted.
PAGESPEED_API_KEY=
# SEO: secret for the scheduled-scan endpoint POST /api/seo/cron (Authorization: Bearer <secret>)
CRON_SECRET=
# AI: Claude API key for Mavi inbox reply suggestions (server-only)
# AI (server-only, never NEXT_PUBLIC_): OpenAI Responses API.
OPENAI_API_KEY=
# Optional model overrides. Defaults: gpt-5.6-luna (ordinary tasks), gpt-5.4-mini (e-mails, inbox replies, agent).
OPENAI_MODEL=
OPENAI_ADVANCED_MODEL=
# Hard stop for all AI across all workspaces per calendar month, in USD (default 8).
AI_GLOBAL_MONTHLY_BUDGET_USD=
# AI: optional development-only fixtures; always disabled in production.
ENABLE_DEMO_AI=false
# OWNER bootstrap: temporary, only set when running the script; remove afterwards.
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=
OWNER_BUSINESS_NAME=
# LIBRARY: optional storage limit per workspace in bytes (e.g. 268435456000 = 250 GB). Empty = show usage only.
LIBRARY_QUOTA_BYTES=

# Private beta: 'closed' disables new sign-ups entirely (default: sign-ups create a pending workspace that a platform admin approves at /beheer).
MAVIX_SIGNUP=
# AI usage controls (server-only). Monthly token budget per workspace (default 300000; a per-workspace limit set in /beheer wins),
# AI requests per user per 24 hours (default 40).
AI_MONTHLY_TOKEN_LIMIT=
AI_DAILY_REQUESTS_PER_USER=
# Only for a model that is not in the built-in OpenAI price table: price in USD per million tokens.
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
